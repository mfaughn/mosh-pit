#!/usr/bin/env bash
# =============================================================================
# mosh — Setup and launcher for the Claude Code dev container
# =============================================================================
#
# FIRST-TIME SETUP:
#   bash /path/to/mosh-pit/mosh setup
#
# LAUNCH:
#   mosh                             # mount current directory
#   mosh ~/projects/my-app           # mount a specific project
#   mosh ~/projects/fe ~/projects/be # mount multiple projects
#
# REBUILD IMAGE (after Containerfile changes):
#   mosh build
#
# =============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration — override by setting these env vars before running
# ---------------------------------------------------------------------------

# Resolve SCRIPT_DIR to the real location of this script, following symlinks.
# This ensures the script works correctly when invoked via /usr/local/bin/claude-dev.
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR="$(cd "$(dirname "$_src")" && pwd)"
IMAGE_NAME="${CLAUDE_DEV_IMAGE:-claude-dev:latest}"
CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$SCRIPT_DIR/config}"
ENV_FILE="$SCRIPT_DIR/.env"

# Host port allocation.
#
# Every container publishes the same set of container-side ports, but each
# project gets a unique block of HOST ports so two running containers never
# collide. A project's block is identified by its "slot" number:
#
#   host base = PORT_BASE + (slot * PORT_STRIDE)
#
# Slot assignments live in $PORTS_FILE (gitignored, host-local). The stride is
# wider than the number of published ports on purpose: the spare ports let a
# future entry be added to CONTAINER_PORTS without renumbering every existing
# allocation.
#
# 20000-29999 is clear of both ephemeral port ranges (macOS 49152-65535, Linux
# 32768-60999), so the OS will never hand one of these out to an outbound
# socket, and clear of the container-side defaults listed below.
PORTS_FILE="$SCRIPT_DIR/.ports"
PORT_BASE=20000
PORT_STRIDE=10
# Container-side ports, in host-offset order: base+0 -> 3000, base+1 -> 4000, ...
# These are the common dev-server defaults, so most tools need no --port flag.
CONTAINER_PORTS=(3000 4000 5173 8000 8080 8888 9000)
CONTAINER_PORT_LABELS=("node/next" "jekyll" "vite" "python http.server" "generic" "jupyter" "spare")

# Version tracking — used to detect stale containers on resume.
#   MOSH_VERSION:        Increment on every meaningful change to container setup.
#   MOSH_MIN_COMPAT:     Increment when a change is breaking (e.g., mount layout).
#                        Containers below this version will be blocked, not just warned.
#
# History:
#   1 — Initial versioned release. Named volumes for ~/.claude, tini as PID 1.
#       Min compat 1: containers without named volumes (bind mount era) are blocked.
#   2 — Shared OAuth credentials volume (mosh-oauth-creds). Auth once, reuse
#       across all projects. Isolate auth-mode env vars from host environment.
#   3 — Migrated from Vertex AI to an API gateway (ANTHROPIC_BASE_URL + tier
#       aliases). Auth env vars are baked in at container creation, so existing
#       containers must be recreated with 'mosh fresh' to pick up the change.
#   4 — Publish a per-project block of host ports (see PORTS_FILE above).
#       Podman fixes port mappings at container-creation time, so existing
#       containers must be recreated with 'mosh fresh' to gain ports.
MOSH_VERSION=4
MOSH_MIN_COMPAT=1

# ---------------------------------------------------------------------------
# Color output helpers
# ---------------------------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()    { echo -e "${GREEN}[mosh]${NC} $*"; }
warn()    { echo -e "${YELLOW}[mosh]${NC} $*"; }
error()   { echo -e "${RED}[mosh] ERROR:${NC} $*" >&2; }

# ---------------------------------------------------------------------------
# Detect container runtime (podman preferred, docker fallback)
# ---------------------------------------------------------------------------
detect_runtime() {
  if command -v podman &>/dev/null; then
    echo "podman"
  elif command -v docker &>/dev/null; then
    echo "docker"
  else
    error "Neither podman nor docker found. Please install one."
    exit 1
  fi
}

RUNTIME=$(detect_runtime)

# ---------------------------------------------------------------------------
# Install plugins from a file (one plugin per line, # comments ignored)
# ---------------------------------------------------------------------------
install_plugins() {
  local container_name="$1"
  local plugin_file="$2"

  [[ -f "$plugin_file" ]] || return 0

  while IFS= read -r line; do
    # Skip comments and blank lines
    line="${line%%#*}"
    line="$(echo "$line" | xargs)"
    [[ -z "$line" ]] && continue

    info "Installing plugin: $line"
    $RUNTIME exec "$container_name" claude plugin install "$line" || \
      warn "Failed to install plugin: $line"
  done < "$plugin_file"
}

# ---------------------------------------------------------------------------
# Common: derive the container name from project directories.
# Usage:
#   container_name_from_dirs /abs/path/to/project1 [/abs/path/to/project2 ...]
#   container_name_from_dirs    # falls back to $(pwd) if no args
# ---------------------------------------------------------------------------
container_name_from_dirs() {
  local dirs=("$@")
  if [[ ${#dirs[@]} -eq 0 ]]; then
    dirs=("$(pwd)")
  fi
  local parts=()
  for d in "${dirs[@]}"; do
    parts+=("$(basename "$d" | tr -cs 'a-zA-Z0-9_-' '-' | sed 's/-$//')")
  done
  # Sort so argument order doesn't matter (hitdev+racktest == racktest+hitdev).
  local sorted
  sorted=$(printf '%s\n' "${parts[@]}" | sort | tr '\n' '-' | sed 's/-$//')
  echo "cc-${sorted}"
}

# ---------------------------------------------------------------------------
# Host port allocation.
#
# Each project gets a unique block of host ports so that two containers running
# at the same time never collide. Container-side ports are identical in every
# container (separate network namespaces make that safe); only the host side is
# allocated per project.
#
# Slot assignments are recorded in $PORTS_FILE. The file is host-local and
# gitignored, and is the first piece of shared host state mosh keeps — unlike
# the dcg/playwright sentinels, which live inside a project's own volume, this
# has to be global, because detecting a collision means seeing every project at
# once.
# ---------------------------------------------------------------------------

# Create the registry with its header comment if it does not exist yet.
# Creation is lazy rather than seeded in cmd_setup: setup exits early on a
# first-ever run, and cmd_launch never calls it, so seeding there would miss
# everyone who set mosh up before this feature existed.
ports_registry_init() {
  [[ -f "$PORTS_FILE" ]] && return 0
  cat > "$PORTS_FILE" <<EOF
# mosh host port allocations.
#
# host base = $PORT_BASE + (slot * $PORT_STRIDE)
#
# Each slot owns $PORT_STRIDE host ports, of which ${#CONTAINER_PORTS[@]} are published. The
# spares exist so a future port can be added without renumbering the entries below.
#
#   mosh ports        Show this project's port map
#   mosh ports list   Show every project's allocation
#
# To free a slot for reuse, delete its line. The next launch of a NEW project
# claims the lowest unused slot. Editing the line of a container that already
# exists has no effect until 'mosh fresh' recreates it, because podman fixes
# port mappings at container-creation time.
#
# container                      slot
EOF
  # stderr: this function runs inside $(port_slot_for ...), whose stdout is
  # the slot number.
  info "Created port registry: $PORTS_FILE" >&2
}

# Echo the slot recorded for a container name, or nothing. Read-only.
ports_lookup_slot() {
  local name="$1"
  [[ -f "$PORTS_FILE" ]] || return 0
  awk -v n="$name" '!/^[[:space:]]*#/ && NF >= 2 && $1 == n { print $2; exit }' \
    "$PORTS_FILE"
}

# Echo the lowest slot number not present in the registry. Taking the lowest
# free slot (rather than max+1) is what makes hand-deleting a line actually
# return that slot to the pool.
ports_next_free_slot() {
  local candidate=0 s
  # Process substitution, not a pipe: a piped `while` runs in a subshell and
  # `candidate` would not survive the loop.
  while read -r s; do
    if [[ "$s" == "$candidate" ]]; then
      candidate=$((candidate + 1))
    elif (( s > candidate )); then
      break
    fi
  done < <(awk '!/^[[:space:]]*#/ && NF >= 2 { print $2 }' "$PORTS_FILE" | sort -n)
  echo "$candidate"
}

# mkdir is atomic on both macOS and Linux, which makes it a usable mutex
# between two mosh launches started in different terminals at the same time.
ports_lock_acquire() {
  local lock="${PORTS_FILE}.lock"
  local waited=0
  while ! mkdir "$lock" 2>/dev/null; do
    if (( waited >= 50 )); then
      warn "Removing stale port-registry lock: $lock" >&2
      rm -rf "$lock"
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  # Release on any exit too, so an interrupted launch cannot wedge the next one.
  trap 'rm -rf "'"$lock"'"' EXIT INT TERM
}

ports_lock_release() {
  rm -rf "${PORTS_FILE}.lock"
  trap - EXIT INT TERM
}

# Echo the slot for a container, allocating and recording one if it has none.
port_slot_for() {
  local name="$1"
  local slot fresh=0
  local max=$(( (30000 - PORT_BASE) / PORT_STRIDE ))

  ports_lock_acquire
  ports_registry_init
  slot="$(ports_lookup_slot "$name")"
  if [[ -z "$slot" ]]; then
    slot="$(ports_next_free_slot)"
    fresh=1
  fi

  # Validate BEFORE recording. Writing first would leave an unusable line in the
  # registry that every later launch would look up and refuse again.
  if (( slot >= max )); then
    ports_lock_release
    error "Port registry is full — every slot below $max is taken."
    error "Free one by deleting its line from $PORTS_FILE"
    return 1
  fi

  if (( fresh )); then
    printf '%-30s %s\n' "$name" "$slot" >> "$PORTS_FILE"
  fi
  ports_lock_release

  echo "$slot"
}

port_base_for_slot() {
  echo $((PORT_BASE + $1 * PORT_STRIDE))
}

# Emit "-p" and "127.0.0.1:<host>:<container>" on alternating lines, for the
# caller to read into an args array. Loopback-only on purpose: these dev servers
# have no authentication in front of them, so they should not reach the LAN.
port_publish_args() {
  local base i
  base=$(port_base_for_slot "$1")
  for i in "${!CONTAINER_PORTS[@]}"; do
    echo "-p"
    echo "127.0.0.1:$((base + i)):${CONTAINER_PORTS[$i]}"
  done
}

# Human-readable map, shared by the launch banner and `mosh ports`.
port_table() {
  local base i
  base=$(port_base_for_slot "$1")
  for i in "${!CONTAINER_PORTS[@]}"; do
    printf '  http://localhost:%-5s ->  container :%-5s %s\n' \
      "$((base + i))" "${CONTAINER_PORTS[$i]}" "${CONTAINER_PORT_LABELS[$i]}"
  done
}

# Warn if something outside mosh already holds part of this project's block.
# Advisory only — podman fails loudly by itself if a bind genuinely cannot be
# made, and this check cannot rule out a port being taken a moment later.
ports_preflight() {
  local base i busy=()
  base=$(port_base_for_slot "$1")
  command -v nc >/dev/null 2>&1 || return 0
  for i in "${!CONTAINER_PORTS[@]}"; do
    if nc -z 127.0.0.1 $((base + i)) >/dev/null 2>&1; then
      busy+=("$((base + i))")
    fi
  done
  if (( ${#busy[@]} > 0 )); then
    warn "Host port(s) already in use: ${busy[*]}"
    warn "Something outside mosh is listening inside this project's block."
    warn "Move the project to a free slot by editing $PORTS_FILE, then 'mosh fresh'."
  fi
}

# ---------------------------------------------------------------------------
# Common: verify prerequisites before launching
# ---------------------------------------------------------------------------
preflight_check() {
  if [[ ! -f "$ENV_FILE" ]]; then
    error ".env not found. Run: $(basename "$0") setup"
    exit 1
  fi

  if ! $RUNTIME image exists "$IMAGE_NAME" 2>/dev/null && \
     ! $RUNTIME inspect "$IMAGE_NAME" &>/dev/null 2>&1; then
    warn "Image $IMAGE_NAME not found. Building now..."
    cmd_build
  fi
}

# ---------------------------------------------------------------------------
# Re-read the host variables that .env references, from a pristine shell.
#
# Without this, launching from a terminal that was opened before you edited
# ~/.zshenv uses the stale values that terminal still holds, so you have to
# exit, source, and relaunch. Reading from a fresh shell means an edit to
# ~/.zshenv takes effect on the very next launch.
#
# The probe shell starts under `env -i` so it inherits nothing from this
# shell — the values reflect the shell config files alone. That also means a
# variable you DELETED from ~/.zshenv correctly comes back empty, which plain
# `source ~/.zshenv` can never detect.
#
# Only names that .env actually references (as ${NAME:-}) are read, so this
# imports nothing else from the host environment.
# ---------------------------------------------------------------------------
refresh_referenced_host_vars() {
  local probe_shell="${SHELL:-}"
  if [[ ! -x "$probe_shell" ]]; then
    probe_shell="$(command -v zsh || command -v bash || true)"
  fi
  [[ -x "$probe_shell" ]] || return 0

  # Collect the ${NAME:-} references out of .env.
  local names=()
  local n
  while IFS= read -r n; do
    [[ -n "$n" ]] && names+=("$n")
  done < <(grep -oE '\$\{[A-Z0-9_]+:-\}' "$ENV_FILE" 2>/dev/null \
           | sed -E 's/^\$\{([A-Z0-9_]+):-\}$/\1/' | sort -u)
  [[ ${#names[@]} -gt 0 ]] || return 0

  # Build a tiny script that prints NAME=value for each name. Written with
  # ${NAME-} rather than a shell-specific indirect expansion so it is valid
  # in both zsh and bash. Names are [A-Z0-9_] only, so this cannot inject.
  local probe_script=""
  for n in "${names[@]}"; do
    probe_script+="printf '%s=%s\\n' '$n' \"\${$n-}\""$'\n'
  done

  local probe_output
  probe_output=$(env -i HOME="$HOME" PATH="$PATH" USER="${USER:-}" \
                   "$probe_shell" -c "$probe_script" 2>/dev/null) || return 0
  [[ -n "$probe_output" ]] || return 0

  local line name value
  while IFS= read -r line; do
    name="${line%%=*}"
    value="${line#*=}"
    [[ "$name" =~ ^[A-Z0-9_]+$ ]] || continue
    if [[ -n "$value" ]]; then
      export "$name=$value"
    else
      unset "$name" 2>/dev/null || true
    fi
  done <<< "$probe_output"
}

# ---------------------------------------------------------------------------
# Common: build the env and volume args used by both launch modes.
# Sets the global COMMON_ARGS array.
# ---------------------------------------------------------------------------
build_common_args() {
  # Pick up any edits made to ~/.zshenv since this terminal was opened.
  refresh_referenced_host_vars

  # Clear auth-mode variables before sourcing .env so that each project's
  # .env file fully controls which auth mode is used. Without this, host
  # env vars (e.g., ANTHROPIC_VERTEX_PROJECT_ID from ~/.zshenv for a work
  # project) bleed through and override the intended auth for unrelated
  # projects that leave these commented out in .env.
  # CLAUDE_CODE_USE_VERTEX is included so a leftover global "=1" from the old
  # Vertex setup cannot survive into a project that has migrated to a gateway.
  # ANTHROPIC_MODEL is unset too: a stale host pin (e.g. a model name from a
  # previous provider) silently overrides the tier aliases and causes 403s.
  # Note this list must NOT include ANTHROPIC_BASE_URL or the tier aliases —
  # .env references those by name, so unsetting them first would blank them.
  unset ANTHROPIC_VERTEX_PROJECT_ID ANTHROPIC_API_KEY CLOUD_ML_REGION \
        CLAUDE_CODE_USE_VERTEX ANTHROPIC_MODEL 2>/dev/null || true

  # Source .env to detect auth mode and expand $VAR references using the
  # host environment (e.g., $GITHUB_TOKEN from ~/.zshenv).
  set -a; source "$ENV_FILE"; set +a

  # Generate a resolved .env file where all $VAR references are expanded.
  # Podman's --env-file reads values literally (no shell expansion), so we
  # produce a temp file with the actual values. Only variables listed in
  # the mosh-pit .env are included — the full host environment is not leaked.
  RESOLVED_ENV_FILE=$(mktemp)
  while IFS= read -r line; do
    # Skip comments and blank lines
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// }" ]] && continue
    # Extract the variable name (everything before the first =)
    local var_name="${line%%=*}"
    [[ -z "$var_name" ]] && continue
    # Look up the resolved value from the current shell environment
    local resolved_value="${!var_name:-}"
    if [[ -n "$resolved_value" ]]; then
      echo "${var_name}=${resolved_value}" >> "$RESOLVED_ENV_FILE"
    fi
  done < "$ENV_FILE"

  # Host directories shared between host and container so skills and plugins
  # only need to be maintained in one place (~/.claude/).
  local host_commands_dir="$HOME/.claude/commands"

  COMMON_ARGS=(
    --shm-size=256m
    --env-file "$RESOLVED_ENV_FILE"
    -e PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
    -e NO_UPDATE_NOTIFIER=1
    # NPM security: block install scripts from untrusted packages, enable audit
    -e NPM_CONFIG_IGNORE_SCRIPTS=true
    -e NPM_CONFIG_AUDIT=true
    -e NPM_CONFIG_FUND=false
    # Repo config is mounted read-only at /mosh-config; synced into ~/.claude at launch.
    # ~/.claude itself lives in a named Podman volume so Claude Code can write to it
    # (e.g., .credentials.json for OAuth token storage).
    -v "$CLAUDE_CONFIG_DIR:/mosh-config:ro,z"
  )

  # Mount host commands so both host and container share the same slash commands.
  # Falls back to config/commands if host doesn't have them.
  if [[ -d "$host_commands_dir" ]]; then
    COMMON_ARGS+=(-v "$host_commands_dir:/home/claude/.claude/commands:ro,z")
    info "Commands: $host_commands_dir (shared with host)"
  fi

  if [[ -n "${ANTHROPIC_VERTEX_PROJECT_ID:-}" ]]; then
    # Vertex AI mode: pass project/region and mount gcloud credentials
    local gcloud_dir="${GCLOUD_CONFIG_DIR:-$HOME/.config/gcloud}"
    COMMON_ARGS+=(
      -e CLAUDE_CODE_USE_VERTEX=1
      -e "CLOUD_ML_REGION=${CLOUD_ML_REGION:-global}"
      -v "$gcloud_dir:/home/claude/.config/gcloud:ro,z"
    )
    info "Auth: Vertex AI (project: $ANTHROPIC_VERTEX_PROJECT_ID)"
  elif [[ -n "${ANTHROPIC_API_KEY:-}" && -n "${ANTHROPIC_BASE_URL:-}" ]]; then
    # Gateway mode (e.g. LiteLLM): key and base URL both come via --env-file.
    info "Auth: API gateway ($ANTHROPIC_BASE_URL)"
  elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
    # Direct API key mode: key is passed via --env-file, nothing else needed.
    # Warn loudly if this looks like a gateway key that lost its base URL —
    # otherwise the key is sent straight to api.anthropic.com and fails.
    info "Auth: Anthropic API key (direct to api.anthropic.com)"
    warn "ANTHROPIC_BASE_URL is not set. If this key belongs to a gateway,"
    warn "export ANTHROPIC_BASE_URL in ~/.zshenv — otherwise requests will fail."
  else
    # OAuth mode: Claude Code handles auth via browser login
    info "Auth: OAuth (Claude Pro/Max)"
  fi

  # Pass through model selection from host environment (e.g., from ~/.zshenv)
  if [[ -n "${ANTHROPIC_MODEL:-}" ]]; then
    COMMON_ARGS+=(-e "ANTHROPIC_MODEL=${ANTHROPIC_MODEL}")
  fi
}

# ---------------------------------------------------------------------------
# setup: first-time initialization
# ---------------------------------------------------------------------------
cmd_setup() {
  info "Running first-time setup..."

  # 1. Check for .env
  if [[ ! -f "$ENV_FILE" ]]; then
    if [[ -f "$SCRIPT_DIR/.env.example" ]]; then
      cp "$SCRIPT_DIR/.env.example" "$ENV_FILE"
      warn ".env created from .env.example."
      warn "  $ENV_FILE"
      warn "OAuth users (Claude Pro/Max): leave the keys commented out and re-run setup."
      warn "Gateway/API key users: set ANTHROPIC_API_KEY (plus ANTHROPIC_BASE_URL"
      warn "for a gateway) in ~/.zshenv, then re-run setup."
      exit 0
    else
      error ".env.example not found alongside this script. Cannot continue."
      exit 1
    fi
  fi

  # 2. Source .env to check required vars (clear auth vars first to prevent
  #    host env from overriding the project's intended auth mode).
  # CLAUDE_CODE_USE_VERTEX is included so a leftover global "=1" from the old
  # Vertex setup cannot survive into a project that has migrated to a gateway.
  # ANTHROPIC_MODEL is unset too: a stale host pin (e.g. a model name from a
  # previous provider) silently overrides the tier aliases and causes 403s.
  # Note this list must NOT include ANTHROPIC_BASE_URL or the tier aliases —
  # .env references those by name, so unsetting them first would blank them.
  unset ANTHROPIC_VERTEX_PROJECT_ID ANTHROPIC_API_KEY CLOUD_ML_REGION \
        CLAUDE_CODE_USE_VERTEX ANTHROPIC_MODEL 2>/dev/null || true
  set -a; source "$ENV_FILE"; set +a

  if [[ -n "${ANTHROPIC_API_KEY:-}" && -n "${ANTHROPIC_BASE_URL:-}" ]]; then
    info "Auth mode: API gateway ($ANTHROPIC_BASE_URL)"
  elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
    info "Auth mode: Anthropic API key"
  elif [[ -n "${ANTHROPIC_VERTEX_PROJECT_ID:-}" ]]; then
    info "Auth mode: Vertex AI (project: $ANTHROPIC_VERTEX_PROJECT_ID)"
  else
    info "Auth mode: OAuth (Claude Code will prompt for browser login)"
  fi

  # 3. Verify container config directory exists
  if [[ ! -d "$CLAUDE_CONFIG_DIR" ]]; then
    error "Config directory not found: $CLAUDE_CONFIG_DIR"
    error "Expected config/ directory in the project repo."
    exit 1
  fi

  if [[ ! -f "$CLAUDE_CONFIG_DIR/settings.json" ]]; then
    error "settings.json not found in $CLAUDE_CONFIG_DIR"
    exit 1
  fi

  # launch.sh runs inside the container on every launch; without it, the
  # container starts but Claude never does.
  if [[ ! -f "$CLAUDE_CONFIG_DIR/launch.sh" ]]; then
    error "launch.sh not found in $CLAUDE_CONFIG_DIR"
    exit 1
  fi

  # 4. Ensure claude.json exists for user-level config
  if [[ ! -f "$CLAUDE_CONFIG_DIR/claude.json" ]]; then
    echo '{"autoUpdates": false}' > "$CLAUDE_CONFIG_DIR/claude.json"
    info "Created claude.json in $CLAUDE_CONFIG_DIR"
  fi

  info "Container config directory: $CLAUDE_CONFIG_DIR"

  # 5. Check gcloud credentials (Vertex AI only)
  if [[ -n "${ANTHROPIC_VERTEX_PROJECT_ID:-}" ]]; then
    local gcloud_creds="${GCLOUD_CONFIG_DIR:-$HOME/.config/gcloud}"
    if [[ ! -d "$gcloud_creds" ]]; then
      warn "gcloud config directory not found: $gcloud_creds"
      warn "Run: gcloud auth application-default login"
      warn "Then re-run setup or just launch — the mount will work once credentials exist."
    else
      info "gcloud credentials directory found: $gcloud_creds"
    fi
  fi

  # 6. Build the image
  cmd_build

  # 7. Install the claude-dev command into /usr/local/bin
  local cmd_target="/usr/local/bin/mosh"
  local cmd_source="$SCRIPT_DIR/mosh"

  if [[ -L "$cmd_target" && "$(readlink "$cmd_target")" == "$cmd_source" ]]; then
    info "mosh command already installed at $cmd_target"
  elif ln -sf "$cmd_source" "$cmd_target" 2>/dev/null; then
    info "Installed: $cmd_target → $cmd_source"
  elif sudo ln -sf "$cmd_source" "$cmd_target" 2>/dev/null; then
    info "Installed (sudo): $cmd_target → $cmd_source"
  else
    warn "Could not install mosh to $cmd_target"
    warn "To install manually: sudo ln -sf \"$cmd_source\" $cmd_target"
  fi

  info "Setup complete! Run 'mosh' from any project directory to start."
}

# ---------------------------------------------------------------------------
# build: build or rebuild the container image
# ---------------------------------------------------------------------------
cmd_build() {
  info "Building container image: $IMAGE_NAME"
  $RUNTIME build -t "$IMAGE_NAME" -f "$SCRIPT_DIR/Containerfile" "$SCRIPT_DIR"
  info "Build complete."
}

# ---------------------------------------------------------------------------
# launch: run Claude Code against one or more project directories
#
# Usage:
#   cmd_launch                        # mounts current directory
#   cmd_launch /path/to/project       # mounts that directory
#   cmd_launch /path/a /path/b        # mounts both under /workspace/
# ---------------------------------------------------------------------------
cmd_launch() {
  preflight_check

  local projects=("$@")

  # Default to current directory if no paths given
  if [[ ${#projects[@]} -eq 0 ]]; then
    projects=("$(pwd)")
  fi

  # Resolve all paths to absolute
  local resolved=()
  for p in "${projects[@]}"; do
    local abs
    abs="$(cd "$p" 2>/dev/null && pwd)" || {
      error "Directory not found: $p"
      exit 1
    }
    resolved+=("$abs")
  done

  # Container name derived from the project directories being mounted.
  # Single project: cc-<dirname>  (e.g. cc-my-app)
  # Multiple projects: cc-<dir1>-<dir2>  (e.g. cc-frontend-backend)
  local container_name
  container_name=$(container_name_from_dirs "${resolved[@]}")

  # Named volume for ~/.claude — persists credentials and state across sessions.
  # Each container gets its own volume so projects don't share OAuth tokens.
  local claude_home_vol="${container_name}-claude-home"

  # Host port block for this project. Resolved before either branch below so
  # that a resumed container reports the same map a new one publishes.
  local port_slot port_base port_list _parg
  port_slot=$(port_slot_for "$container_name")
  port_base=$(port_base_for_slot "$port_slot")
  port_list=$(IFS=,; echo "${CONTAINER_PORTS[*]}")
  # Passed on the `exec` rather than in COMMON_ARGS: COMMON_ARGS only applies to
  # containers being created, whereas exec-time -e also reaches resumed ones.
  local port_env=(
    -e "MOSH_PORTS=$port_list"
    -e "MOSH_PORT=${CONTAINER_PORTS[0]}"
    -e "MOSH_PORT_BASE=$port_base"
  )

  # The config sync + Claude launch logic lives in config/launch.sh, which is
  # mounted read-only at /mosh-config/launch.sh. Keeping it in a real file
  # (rather than an inline string) means shellcheck and editors can see it, and
  # `ps` shows one readable line instead of the whole script.

  # Check if a stopped container with this name already exists.
  if $RUNTIME container exists "$container_name" 2>/dev/null; then
    # Check the container's mosh version label against the current script.
    local container_version
    container_version=$($RUNTIME inspect "$container_name" \
      --format '{{index .Config.Labels "mosh.version"}}' 2>/dev/null || echo "")

    # Containers created before version labeling have no label (empty string).
    # Treat them as version 0.
    container_version="${container_version:-0}"

    if [[ "$container_version" -lt "$MOSH_MIN_COMPAT" ]]; then
      error "This container was created by an incompatible version of mosh (v${container_version})."
      error "Current version is v${MOSH_VERSION} (minimum compatible: v${MOSH_MIN_COMPAT})."
      error ""
      error "Run 'mosh fresh' to recreate it with the current configuration."
      return 1
    elif [[ "$container_version" -lt "$MOSH_VERSION" ]]; then
      warn "This container was created by mosh v${container_version} (current: v${MOSH_VERSION})."
      warn "Consider running 'mosh fresh' to pick up the latest configuration."
      warn ""
    fi

    # Verify the container's /workspace mounts match what was requested.
    # Build the list of expected workspace mount destinations.
    local expected_mounts=()
    if [[ ${#resolved[@]} -eq 1 ]]; then
      expected_mounts+=("/workspace")
    else
      for p in "${resolved[@]}"; do
        expected_mounts+=("/workspace/$(basename "$p")")
      done
    fi

    # Get actual workspace mounts from the container.
    local actual_mounts
    actual_mounts=$($RUNTIME inspect "$container_name" \
      --format '{{range .Mounts}}{{.Destination}}{{"\n"}}{{end}}' 2>/dev/null \
      | grep -E '^/workspace(/|$)' | sort)
    local expected_sorted
    expected_sorted=$(printf '%s\n' "${expected_mounts[@]}" | sort)

    if [[ "$actual_mounts" != "$expected_sorted" ]]; then
      error "Container '$container_name' exists but has different project mounts."
      error "  Requested: $(printf '%s\n' "${expected_mounts[@]}")"
      error "  Container: ${actual_mounts:-"(none)"}"
      error ""
      error "Run 'mosh fresh $(printf '%s ' "$@")' to recreate with the new mounts."
      return 1
    fi

    info "Resuming existing container: $container_name"

    # Only advertise URLs the container can actually serve. A container created
    # before v4 has no published ports, and printing its would-be map would just
    # produce connection-refused surprises. Gate on the version label read above
    # rather than inspecting port bindings: it is already in hand, and it cannot
    # misreport because of a runtime-specific inspect field name.
    if (( container_version >= 4 )); then
      info "Ports (slot $port_slot):"
      port_table "$port_slot"
    else
      warn "This container publishes no ports. Run 'mosh fresh' to add them."
      # Blank the port env to match. Handing a pre-v4 container a populated
      # $MOSH_PORTS would make the in-container banner and config/CLAUDE.md
      # advertise URLs that refuse connections — contradicting the warning above.
      # Kept as a one-element array rather than (), because "${empty[@]}" under
      # `set -u` is an error in bash 3.2, which is what /bin/bash is on macOS.
      port_env=(-e "MOSH_PORTS=")
    fi

    info "Press Ctrl+C or type /exit to quit."
    echo ""
    $RUNTIME start "$container_name"
    $RUNTIME exec -it "${port_env[@]}" -e "MOSH_NEW_SESSION=${MOSH_NEW_SESSION:-0}" "$container_name" bash /mosh-config/launch.sh
    $RUNTIME stop "$container_name" 2>/dev/null || true
    return
  fi

  # No existing container — create a new one.
  build_common_args
  COMMON_ARGS+=(--name "$container_name")
  COMMON_ARGS+=(--label "mosh.version=$MOSH_VERSION")
  # Named volume for ~/.claude provides a writable home for credentials and state.
  COMMON_ARGS+=(--mount "type=volume,source=${claude_home_vol},target=/home/claude/.claude")
  # Shared OAuth credentials volume — authenticate once, use across all projects.
  # Credentials are seeded from here into new containers and saved back on exit.
  COMMON_ARGS+=(--mount "type=volume,source=mosh-oauth-creds,target=/home/claude/.oauth-creds")

  # Publish this project's host port block. Podman fixes port mappings at
  # creation time, which is why the whole block goes on now whether or not it
  # gets used — adding one later would mean recreating the container.
  ports_preflight "$port_slot"
  while IFS= read -r _parg; do
    COMMON_ARGS+=("$_parg")
  done < <(port_publish_args "$port_slot")

  info "Container: $container_name (new)"
  info "Ports (slot $port_slot):"
  port_table "$port_slot"

  if [[ ${#resolved[@]} -eq 1 ]]; then
    # --- Single project: mount at /workspace root ---
    local project_dir="${resolved[0]}"
    COMMON_ARGS+=(-v "$project_dir:/workspace:z")
    COMMON_ARGS+=(-w /workspace)
    info "Project: $project_dir → /workspace"
  else
    # --- Multiple projects: each mounted as /workspace/<dirname> ---
    COMMON_ARGS+=(-w /workspace)
    for project_dir in "${resolved[@]}"; do
      local dirname
      dirname="$(basename "$project_dir")"
      COMMON_ARGS+=(-v "$project_dir:/workspace/$dirname:z")
      info "Project: $project_dir → /workspace/$dirname"
    done
  fi

  # Run the container as a persistent daemon (sleep infinity) so we can
  # always attach via `exec -it`. This avoids TTY issues with `podman start -ai`
  # on macOS, where full-screen TUI output doesn't render on reattach.
  $RUNTIME run -d "${COMMON_ARGS[@]}" "$IMAGE_NAME" sleep infinity

  # --- New container setup: update Claude Code, provision, install plugins ---

  # Update Claude Code to latest via the native installer. The base image may
  # be stale if it hasn't been rebuilt recently, so always update on new containers.
  info "Updating Claude Code to latest..."
  $RUNTIME exec "$container_name" bash -c 'curl -fsSL https://claude.ai/install.sh | bash' 2>&1 \
    | tail -3
  local cc_version
  cc_version=$($RUNTIME exec "$container_name" claude --version 2>/dev/null || echo "unknown")
  info "Claude Code: $cc_version"

  # Run provision scripts (system packages) as root.
  #
  # STALE-CWD GUARD: The DEBUG trap below protects against a class of bug
  # where a provision step compiles something in a temp directory, cleans it
  # up, and leaves the shell's cwd pointing at a deleted path. Subsequent
  # commands (e.g. `gem install`, `pip install`) spawn subprocesses that call
  # getcwd(), which fails with ENOENT because the directory inode is gone.
  #
  # How it works:
  #   - `set -T` (functrace) propagates the DEBUG trap into sourced scripts.
  #     Without this, the trap only fires once before `source` itself, not
  #     before each command inside the sourced script.
  #   - The DEBUG trap fires before every command in the sourced script.
  #   - `pwd -P` resolves the real path; it fails if the dir was deleted.
  #   - On failure, `cd /workspace` silently restores a valid cwd.
  #   - When the cwd is fine (the common case), cost is one syscall — negligible.
  #
  # Example of the problem this solves:
  #   A provision script compiles Ruby from source in /tmp/ruby-build-xxx,
  #   then `rm -rf`s that dir. The next line runs `gem install bundler`.
  #   Ruby's threaded gem fetcher calls getcwd() in each thread and crashes:
  #     Errno::ENOENT - No such file or directory - getcwd
  #   The same can happen with any language/tool that builds in a temp dir.
  #
  # If you're modifying this: all three pieces are required:
  #   - `set -T` — without it, the trap doesn't fire inside the sourced script
  #   - `source` (not `bash <script>`) — keeps everything in one shell process
  #   - `pwd -P` (not `cd .`) — `cd .` succeeds on Linux even for deleted dirs
  for project_dir in "${resolved[@]}"; do
    # Compute the container-side path for this project.
    # Single project: /workspace  |  Multi-project: /workspace/<dirname>
    local container_path
    if [[ ${#resolved[@]} -eq 1 ]]; then
      container_path="/workspace"
    else
      container_path="/workspace/$(basename "$project_dir")"
    fi

    if [[ -f "$project_dir/.claude-dev/provision.sh" ]]; then
      info "Running provision script for $(basename "$project_dir")..."
      $RUNTIME exec --workdir "$container_path" --user root "$container_name" \
        bash -c 'set -T; trap '\''pwd -P >/dev/null 2>&1 || cd /workspace 2>/dev/null'\'' DEBUG; source '"$container_path"'/.claude-dev/provision.sh'
    fi
  done

  # Install plugins from default list and per-project lists.
  local default_plugins="$SCRIPT_DIR/config/default-plugins.txt"
  install_plugins "$container_name" "$default_plugins"
  for project_dir in "${resolved[@]}"; do
    install_plugins "$container_name" "$project_dir/.claude-dev/plugins.txt"
  done

  info "Setup complete."

  info "Press Ctrl+C or type /exit to quit."
  echo ""
  $RUNTIME exec -it "${port_env[@]}" -e "MOSH_NEW_SESSION=${MOSH_NEW_SESSION:-0}" "$container_name" bash /mosh-config/launch.sh
  $RUNTIME stop "$container_name" 2>/dev/null || true
  rm -f "${RESOLVED_ENV_FILE:-}"
}

# ---------------------------------------------------------------------------
# save: snapshot a project's container as an image for backup
#
# Usage:
#   claude-dev save              # saves cc-<cwd> as cc-<cwd>:backup
#   claude-dev save my-tag       # saves cc-<cwd> as cc-<cwd>:my-tag
# ---------------------------------------------------------------------------
cmd_save() {
  local container_name
  container_name=$(container_name_from_dirs)
  local tag="${1:-backup}"
  local image_tag="$container_name:$tag"

  if ! $RUNTIME container exists "$container_name" 2>/dev/null; then
    error "No container found: $container_name"
    error "Start claude-dev from this project directory first."
    exit 1
  fi

  info "Saving container '$container_name' as image '$image_tag'..."
  $RUNTIME commit "$container_name" "$image_tag"
  info "Saved."
  info "List snapshots: mosh snapshots"
  info "Restore:        mosh restore $tag"
}

# ---------------------------------------------------------------------------
# snapshots: list saved snapshots for the current project
# ---------------------------------------------------------------------------
cmd_snapshots() {
  local container_name
  container_name=$(container_name_from_dirs)
  info "Saved snapshots for $container_name:"
  $RUNTIME images --format "table {{.Repository}}:{{.Tag}}  {{.CreatedSince}}  {{.Size}}" \
    | grep "^$container_name:" || echo "  (none)"
}

# ---------------------------------------------------------------------------
# restore: replace the current container with a saved snapshot
#
# Usage:
#   claude-dev restore            # restore from cc-<cwd>:backup
#   claude-dev restore my-tag     # restore from cc-<cwd>:my-tag
# ---------------------------------------------------------------------------
cmd_restore() {
  local container_name
  container_name=$(container_name_from_dirs)
  local tag="${1:-backup}"
  local image_tag="$container_name:$tag"

  if ! $RUNTIME image exists "$image_tag" 2>/dev/null; then
    error "No snapshot found: $image_tag"
    info "Available snapshots:"
    cmd_snapshots
    exit 1
  fi

  # Remove the current container if it exists
  if $RUNTIME container exists "$container_name" 2>/dev/null; then
    info "Removing current container: $container_name"
    $RUNTIME rm -f "$container_name"
  fi

  # Launch from the saved image instead of the base image
  info "Restoring from snapshot: $image_tag"
  IMAGE_NAME="$image_tag"
  cmd_launch
}

# ---------------------------------------------------------------------------
# provision: run the provision script against an existing container
# ---------------------------------------------------------------------------
cmd_provision() {
  local container_name
  container_name=$(container_name_from_dirs)
  local provision_script="$(pwd)/.claude-dev/provision.sh"

  if [[ ! -f "$provision_script" ]]; then
    error "No provision script found: $provision_script"
    error "Claude Code creates this file automatically when it installs packages."
    exit 1
  fi

  if ! $RUNTIME container exists "$container_name" 2>/dev/null; then
    error "No container found: $container_name"
    error "Start claude-dev from this project directory first."
    exit 1
  fi

  info "Running provision script in $container_name..."
  $RUNTIME start "$container_name" 2>/dev/null || true
  $RUNTIME exec --user root "$container_name" bash /workspace/.claude-dev/provision.sh
  $RUNTIME stop "$container_name" 2>/dev/null || true
  info "Provisioning complete."
}

# ---------------------------------------------------------------------------
# fresh: remove existing container and start clean from base image
# ---------------------------------------------------------------------------
cmd_fresh() {
  # Resolve project paths the same way cmd_launch does, so we compute
  # the same container name that cmd_launch will look for.
  local projects=("$@")
  if [[ ${#projects[@]} -eq 0 ]]; then
    projects=("$(pwd)")
  fi
  local resolved=()
  for p in "${projects[@]}"; do
    local abs
    abs="$(cd "$p" 2>/dev/null && pwd)" || {
      error "Directory not found: $p"
      exit 1
    }
    resolved+=("$abs")
  done

  local container_name
  container_name=$(container_name_from_dirs "${resolved[@]}")

  if $RUNTIME container exists "$container_name" 2>/dev/null; then
    info "Removing existing container: $container_name"
    $RUNTIME rm -f "$container_name"
  fi

  cmd_launch "$@"
}

# ---------------------------------------------------------------------------
# update: update Claude Code inside an existing container without launching it
# ---------------------------------------------------------------------------
cmd_update() {
  local projects=("$@")
  if [[ ${#projects[@]} -eq 0 ]]; then
    projects=("$(pwd)")
  fi
  local resolved=()
  for p in "${projects[@]}"; do
    local abs
    abs="$(cd "$p" 2>/dev/null && pwd)" || {
      error "Directory not found: $p"
      exit 1
    }
    resolved+=("$abs")
  done

  local container_name
  container_name=$(container_name_from_dirs "${resolved[@]}")

  if ! $RUNTIME container exists "$container_name" 2>/dev/null; then
    error "No container found: $container_name"
    error "Start mosh from this project directory first to create one."
    exit 1
  fi

  info "Starting container: $container_name"
  $RUNTIME start "$container_name"

  info "Updating Claude Code..."
  $RUNTIME exec "$container_name" bash -c 'curl -fsSL https://claude.ai/install.sh | bash'

  # Show the new version
  local new_version
  new_version=$($RUNTIME exec "$container_name" claude --version 2>/dev/null || echo "unknown")
  info "Claude Code updated to: $new_version"

  $RUNTIME stop "$container_name" 2>/dev/null || true
  info "Container stopped. Run 'mosh' to launch with the updated version."
}

# ---------------------------------------------------------------------------
# dcg: toggle the destructive_command_guard hook for this project.
#
# State is stored as a sentinel file ~/.claude/.dcg-enabled in the project's
# named volume. The launcher's settings.json sync injects the PreToolUse
# hook iff the sentinel exists, so toggling here takes effect on next launch.
#
# Usage:
#   mosh dcg            Show current state for this project
#   mosh dcg on         Enable dcg for this project
#   mosh dcg off        Disable dcg for this project
# ---------------------------------------------------------------------------
cmd_dcg() {
  local subcmd="${1:-status}"
  local container_name claude_vol
  container_name=$(container_name_from_dirs)
  claude_vol="${container_name}-claude-home"

  case "$subcmd" in
    on|enable)
      $RUNTIME run --rm \
        --mount "type=volume,source=${claude_vol},target=/v" \
        "$IMAGE_NAME" touch /v/.dcg-enabled
      info "dcg ENABLED for $container_name"
      info "Restart your session (or run 'mosh new') to load the hook."
      ;;
    off|disable)
      $RUNTIME run --rm \
        --mount "type=volume,source=${claude_vol},target=/v" \
        "$IMAGE_NAME" rm -f /v/.dcg-enabled
      info "dcg DISABLED for $container_name"
      info "Restart your session (or run 'mosh new') to drop the hook."
      ;;
    status|"")
      if $RUNTIME run --rm \
           --mount "type=volume,source=${claude_vol},target=/v" \
           "$IMAGE_NAME" test -f /v/.dcg-enabled 2>/dev/null; then
        info "dcg: ENABLED for $container_name"
      else
        info "dcg: DISABLED for $container_name"
      fi
      ;;
    *)
      error "Unknown dcg subcommand: $subcmd"
      error "Usage: $(basename "$0") dcg [on|off|status]"
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# playwright: toggle the Playwright MCP server for this project.
#
# Off by default for every project — Playwright spawns Chromium and exposes a
# wide tool surface, which is wasted overhead for projects that don't drive a
# browser. State is a per-project sentinel ~/.claude/.playwright-enabled in
# the named volume, mirroring `mosh dcg`.
#
# Usage:
#   mosh playwright            Show current state for this project
#   mosh playwright on         Enable Playwright MCP for this project
#   mosh playwright off        Disable Playwright MCP for this project
# ---------------------------------------------------------------------------
cmd_playwright() {
  local subcmd="${1:-status}"
  local container_name claude_vol
  container_name=$(container_name_from_dirs)
  claude_vol="${container_name}-claude-home"

  case "$subcmd" in
    on|enable)
      $RUNTIME run --rm \
        --mount "type=volume,source=${claude_vol},target=/v" \
        "$IMAGE_NAME" touch /v/.playwright-enabled
      info "Playwright MCP ENABLED for $container_name"
      info "Restart your session (or run 'mosh new') to load the server."
      ;;
    off|disable)
      $RUNTIME run --rm \
        --mount "type=volume,source=${claude_vol},target=/v" \
        "$IMAGE_NAME" rm -f /v/.playwright-enabled
      info "Playwright MCP DISABLED for $container_name"
      info "Restart your session (or run 'mosh new') to drop the server."
      ;;
    status|"")
      if $RUNTIME run --rm \
           --mount "type=volume,source=${claude_vol},target=/v" \
           "$IMAGE_NAME" test -f /v/.playwright-enabled 2>/dev/null; then
        info "Playwright MCP: ENABLED for $container_name"
      else
        info "Playwright MCP: DISABLED for $container_name"
      fi
      ;;
    *)
      error "Unknown playwright subcommand: $subcmd"
      error "Usage: $(basename "$0") playwright [on|off|status]"
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# ports: show this project's host port block, or every project's.
#
# Read-only. Allocation happens at launch, never here — inspecting the map
# should not have the side effect of claiming a slot for a project that may
# never be launched.
#
# Usage:
#   mosh ports         Show this project's port map
#   mosh ports list    Show every recorded allocation
# ---------------------------------------------------------------------------
cmd_ports() {
  local subcmd="${1:-show}"

  case "$subcmd" in
    show|"")
      local container_name slot
      container_name=$(container_name_from_dirs)
      slot=$(ports_lookup_slot "$container_name")
      if [[ -z "$slot" ]]; then
        info "$container_name has no port allocation yet."
        info "One is assigned automatically the next time you run 'mosh' here."
        return 0
      fi
      info "$container_name — slot $slot, host base $(port_base_for_slot "$slot")"
      port_table "$slot"
      ;;
    list)
      if [[ ! -f "$PORTS_FILE" ]]; then
        info "No allocations yet ($PORTS_FILE does not exist)."
        return 0
      fi
      info "Port allocations ($PORTS_FILE):"
      printf '  %-30s %-6s %-8s %s\n' "CONTAINER" "SLOT" "BASE" "STATUS"
      local name slot status
      while read -r name slot _; do
        [[ -z "$name" ]] && continue
        case "$name" in \#*) continue ;; esac
        [[ -z "$slot" ]] && continue
        if $RUNTIME container exists "$name" 2>/dev/null; then
          status="active"
        else
          status="(stale — no container)"
        fi
        printf '  %-30s %-6s %-8s %s\n' \
          "$name" "$slot" "$(port_base_for_slot "$slot")" "$status"
      done < "$PORTS_FILE"
      echo ""
      info "To free a slot for reuse, delete its line from $PORTS_FILE."
      info "A slot change only takes effect after 'mosh fresh' recreates the container."
      ;;
    *)
      error "Unknown ports subcommand: $subcmd"
      error "Usage: $(basename "$0") ports [list]"
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# help
# ---------------------------------------------------------------------------
cmd_help() {
  cat <<EOF
Usage: $(basename "$0") [command] [project-path ...]

Commands:
  (none)    Launch Claude Code (resumes last session and container)
  new       Start a fresh session (skip session resume)
  setup     First-time setup: create .env, verify config, build image
  build     (Re)build the container image
  save      Snapshot the project's container as an image (backup)
  snapshots List saved snapshots for the current project
  restore   Replace current container with a saved snapshot
  fresh     Remove existing container and start clean from base image
  provision Re-run config/provision.sh in the project's container
  update    Update Claude Code (npm) inside existing container without launching
  dcg        Toggle the destructive-command-guard hook (on|off|status)
  playwright Toggle the Playwright MCP server (on|off|status)
  ports      Show this project's host port map (or 'ports list' for all)
  help       Show this help

Launch modes:
  $(basename "$0")                          Mount current directory as /workspace
  $(basename "$0") ~/projects/my-app        Mount specific project as /workspace
  $(basename "$0") ~/proj/fe ~/proj/be      Mount multiple as /workspace/fe, /workspace/be

Environment variables (set in .env):
  ANTHROPIC_API_KEY             Anthropic or gateway API key
  ANTHROPIC_BASE_URL            API gateway URL (e.g. LiteLLM); unset = Anthropic
  ANTHROPIC_DEFAULT_OPUS_MODEL  What "opus" resolves to (also _SONNET_, _HAIKU_,
                                _FABLE_ — _FABLE_ also unhides Fable in /model)
  ANTHROPIC_VERTEX_PROJECT_ID   GCP project with Vertex AI (legacy)
  CLOUD_ML_REGION               Vertex AI region (default: global)
  CLAUDE_CONFIG_DIR             Container Claude config (default: ./config in repo)
  GCLOUD_CONFIG_DIR             gcloud config path (default: ~/.config/gcloud)
  CLAUDE_DEV_IMAGE              Container image name (default: claude-dev:latest)

Example workflow:
  # One-time setup (also installs the mosh command to /usr/local/bin)
  bash /path/to/mosh-pit/mosh setup

  # Daily use — run from any project directory
  cd ~/projects/my-app && mosh
  # or
  mosh ~/projects/my-app
  # or multiple projects
  mosh ~/projects/frontend ~/projects/backend
EOF
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
case "${1:-}" in
  setup)          cmd_setup ;;
  build)          cmd_build ;;
  save)           shift; cmd_save "$@" ;;
  snapshots)      cmd_snapshots ;;
  restore)        shift; cmd_restore "$@" ;;
  fresh)          shift; cmd_fresh "$@" ;;
  provision)      cmd_provision ;;
  update)         shift; cmd_update "$@" ;;
  dcg)            shift; cmd_dcg "$@" ;;
  playwright)     shift; cmd_playwright "$@" ;;
  ports)          shift; cmd_ports "$@" ;;
  new)            shift; MOSH_NEW_SESSION=1 cmd_launch "$@" ;;
  help|-h|--help) cmd_help ;;
  "")             cmd_launch ;;
  *)
    # If the first arg is a directory, treat everything as project paths.
    # Otherwise it's an unknown command.
    if [[ -d "$1" ]]; then
      cmd_launch "$@"
    else
      error "Unknown command: $1"
      cmd_help
      exit 1
    fi
    ;;
esac
