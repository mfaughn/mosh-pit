# Claude Code Dev Container — Environment Configuration
# -------------------------------------------------------
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# .env is in .gitignore — never commit it.
# .env.example IS committed — it documents what's needed.


# =============================================================================
# REQUIRED: Google Cloud / Vertex AI
# =============================================================================

# GCP project ID that has Vertex AI and the Claude models enabled.
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id

# Vertex AI region where your Claude endpoint is deployed.
# Common values: us-east5, us-central1
CLOUD_ML_REGION=us-east5


# =============================================================================
# OPTIONAL: Path overrides
# =============================================================================

# Absolute path to the project directory you want to work on.
# If unset, compose uses the current working directory (recommended —
# just cd to your project first).
# PROJECT_DIR=/absolute/path/to/your/project

# Path to your gcloud config directory on the host.
# Only change this if your gcloud config lives somewhere non-standard.
# GCLOUD_CONFIG_DIR=~/.config/gcloud

# Path where Claude Code's config is persisted on the host.
# This keeps your MCP settings, Claude config, and history across runs.
# CLAUDE_CONFIG_DIR=~/.claude-dev-config


# =============================================================================
# OPTIONAL: Claude Code behavior
# =============================================================================

# Override the default model if needed.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
